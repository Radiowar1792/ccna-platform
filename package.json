{
  "name": "ccna-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Plateforme perso de préparation au CCNA 200-301",
  "scripts": {
    "dev": "vite dev --host",
    "build": "svelte-kit sync && vite build",
    "preview": "vite preview --host",
    "start": "node --env-file-if-exists=.env build/index.js",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "smoke": "bash scripts/smoke.sh"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "ts-fsrs": "^5.4.2"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "5.5.7",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@types/node": "^24.0.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
