# Port d'écoute de l'application
PORT=3000
HOST=0.0.0.0
# URL publique (ex. http://192.168.1.50:3000 ou https://ccna.maison.lan)
ORIGIN=http://localhost:3000
# Mot de passe de connexion (laisser vide = pas de mot de passe, déconseillé)
APP_PASSWORD=change-moi
# Secret pour signer le cookie de session (génère-le avec : openssl rand -hex 32)
SESSION_SECRET=remplace-par-une-longue-chaine-aleatoire
# Emplacement de la base SQLite
DATABASE_PATH=./data/ccna.db
# Taille max des envois (import de paquets Anki .apkg)
BODY_SIZE_LIMIT=60M
# Optionnel : clé YouTube Data API v3 pour synchroniser la playlist de Jeremy (gratuit)
YOUTUBE_API_KEY=
